#!/bin/sh

ROOT=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd) || exit 1
OS2EMX_SOURCE_ROOT=${OS2EMX_SOURCE_ROOT:-$(dirname -- "$ROOT")}
if test -z "${OS2EMX_BUILD_ROOT:-}"; then
  echo "Set OS2EMX_BUILD_ROOT before bootstrapping (e.g. /data/build-nix)." >&2
  exit 2
fi
CROSS_BUILD_ROOT=${OS2EMX_CROSS_BUILD_ROOT:-${OS2EMX_BUILD_ROOT%/}/cross-os2emx}
AUTOTOOLSDIR=${AUTOTOOLSDIR:-${CROSS_BUILD_ROOT%/}/autotools}
BOOTSTRAP_SOURCE_ROOT=${CROSS_BUILD_ROOT%/}/bootstrap-sources
export OS2EMX_SOURCE_ROOT OS2EMX_CROSS_BUILD_ROOT="$CROSS_BUILD_ROOT" AUTOTOOLSDIR
export OS2EMX_BOOTSTRAP_SOURCE_ROOT="$BOOTSTRAP_SOURCE_ROOT"

cd "$ROOT" || exit 1
echo "Preparing autotools for bootstrapping..."
make -C "$ROOT" all-autotools AUTOTOOLSDIR="$AUTOTOOLSDIR" || exit 1
echo

# Get the list of source repositories to process.
# If arguments are provided, use them as the list.
# Otherwise, process all required repositories.
if [ $# -gt 0 ]; then
  COMPONENTS="$*"
  echo "Specified source repositories: $COMPONENTS"
else
  COMPONENTS="binutils-os2 gcc-os2 libc-os2 cmake-os2"
  echo "All source repositories: $COMPONENTS"
fi


export PATH="$AUTOTOOLSDIR/bin:$PATH"
mkdir -p "$BOOTSTRAP_SOURCE_ROOT" || exit 1

TEMP_ARCHIVE=
TEMP_SNAPSHOT=
TEMP_BACKUP=
TEMP_DEST=
cleanup() {
  if test -n "$TEMP_ARCHIVE"; then
    rm -f "$TEMP_ARCHIVE"
  fi
  if test -n "$TEMP_SNAPSHOT"; then
    rm -rf "$TEMP_SNAPSHOT"
  fi
  if test -n "$TEMP_BACKUP" && { test -e "$TEMP_BACKUP" || test -L "$TEMP_BACKUP"; }; then
    if test ! -e "$TEMP_DEST" && test ! -L "$TEMP_DEST"; then
      mv "$TEMP_BACKUP" "$TEMP_DEST"
    else
      rm -rf "$TEMP_BACKUP"
    fi
  fi
}
trap cleanup 0
trap 'exit 1' HUP INT TERM

for component in $COMPONENTS; do
  case "$component" in
    binutils-os2) src="$OS2EMX_SOURCE_ROOT/binutils-os2"; snapshot_component="$component"; required=conf-cross-os2emx ;;
    gcc-os2) src="$OS2EMX_SOURCE_ROOT/gcc-os2"; snapshot_component="$component"; required=conf-cross-os2emx ;;
    libc|libc-os2) src="$OS2EMX_SOURCE_ROOT/libc-os2"; snapshot_component=libc-os2; required=src/emx/Makefile.cross ;;
    cmake-os2) src="$OS2EMX_SOURCE_ROOT/cmake-os2"; snapshot_component="$component"; required=configure ;;
    *) echo "Unknown source repository: $component" >&2; exit 2 ;;
  esac

  if ! git -C "$src" rev-parse --show-toplevel >/dev/null 2>&1; then
    echo "Missing Git source repository: $src" >&2
    exit 1
  fi
  if test ! -f "$src/$required"; then
    echo "Required OS/2 cross-build file is missing: $src/$required" >&2
    exit 1
  fi

  snapshot="$BOOTSTRAP_SOURCE_ROOT/$snapshot_component"
  TEMP_DEST="$snapshot"
  TEMP_ARCHIVE="$BOOTSTRAP_SOURCE_ROOT/.${snapshot_component}.tar.$$"
  TEMP_SNAPSHOT="$BOOTSTRAP_SOURCE_ROOT/.${snapshot_component}.tmp.$$"
  TEMP_BACKUP="$BOOTSTRAP_SOURCE_ROOT/.${snapshot_component}.previous.$$"
  if test -e "$TEMP_ARCHIVE" || test -L "$TEMP_ARCHIVE" \
    || test -e "$TEMP_SNAPSHOT" || test -L "$TEMP_SNAPSHOT" \
    || test -e "$TEMP_BACKUP" || test -L "$TEMP_BACKUP"; then
    echo "Refusing to overwrite a temporary bootstrap path for $component." >&2
    exit 1
  fi
  mkdir "$TEMP_SNAPSHOT" || exit 1

  echo "Copying $component from $src into the build root..."
  ( cd "$src" && tar --exclude-vcs -cf "$TEMP_ARCHIVE" . ) || exit 1
  ( cd "$TEMP_SNAPSHOT" && tar -xf "$TEMP_ARCHIVE" ) || exit 1
  rm -f "$TEMP_ARCHIVE" || exit 1
  TEMP_ARCHIVE=

  if test ! -f "$TEMP_SNAPSHOT/$required"; then
    echo "Required OS/2 cross-build file is missing in the source snapshot: $TEMP_SNAPSHOT/$required" >&2
    exit 1
  fi

  echo "Bootstrapping $component in $TEMP_SNAPSHOT..."
  if test -f "$TEMP_SNAPSHOT/autogen.sh"; then
    ( cd "$TEMP_SNAPSHOT" && sh ./autogen.sh ) || exit 1
  fi

  printf '%s\n' "Generated by $ROOT/bootstrap from $src" > "$TEMP_SNAPSHOT/.os2emx-bootstrap-source" || exit 1
  if test -e "$snapshot" || test -L "$snapshot"; then
    if test ! -f "$snapshot/.os2emx-bootstrap-source"; then
      echo "Refusing to replace an unmarked source snapshot: $snapshot" >&2
      exit 1
    fi
    mv "$snapshot" "$TEMP_BACKUP" || exit 1
  fi
  if ! mv "$TEMP_SNAPSHOT" "$snapshot"; then
    if test -e "$TEMP_BACKUP"; then
      mv "$TEMP_BACKUP" "$snapshot"
      TEMP_BACKUP=
    fi
    exit 1
  fi
  TEMP_SNAPSHOT=
  if test -e "$TEMP_BACKUP"; then
    rm -rf "$TEMP_BACKUP" || exit 1
  fi
  TEMP_BACKUP=
  TEMP_DEST=

  echo
done

echo "Done. Source snapshots: $BOOTSTRAP_SOURCE_ROOT"
echo "Pass OS2EMX_SOURCE_ROOT=$BOOTSTRAP_SOURCE_ROOT to make all toolchain targets use the snapshots."
