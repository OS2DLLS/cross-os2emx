# Workspace-wide default CMake toolchain for OS/2 EMX/OMF targets.
# CMake consumes CMAKE_TOOLCHAIN_FILE from the environment on a fresh configure.
# Project-specific toolchains (QtBase and Qt consumers) may override it.

foreach(_required OS2EMX_PREFIX OS2EMX_SYSROOT OS2EMX_CC OS2EMX_CXX OS2EMX_AR)
  if(NOT DEFINED ENV{${_required}} OR "$ENV{${_required}}" STREQUAL "")
    message(FATAL_ERROR "${_required} must be set by /data/shell.nix")
  endif()
endforeach()

set(CMAKE_SYSTEM_NAME OS2)
set(CMAKE_SYSTEM_PROCESSOR i686)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(NOT DEFINED CMAKE_C_COMPILER OR CMAKE_C_COMPILER STREQUAL "")
  set(CMAKE_C_COMPILER "$ENV{OS2EMX_CC}" CACHE FILEPATH "OS/2 target C compiler")
endif()
if(NOT DEFINED CMAKE_CXX_COMPILER OR CMAKE_CXX_COMPILER STREQUAL "")
  set(CMAKE_CXX_COMPILER "$ENV{OS2EMX_CXX}" CACHE FILEPATH "OS/2 target C++ compiler")
endif()
if(NOT DEFINED CMAKE_AR OR CMAKE_AR STREQUAL "")
  set(CMAKE_AR "$ENV{OS2EMX_AR}" CACHE FILEPATH "Host OMF archiver")
endif()
if(NOT DEFINED CMAKE_SYSROOT OR CMAKE_SYSROOT STREQUAL "")
  set(CMAKE_SYSROOT "$ENV{OS2EMX_SYSROOT}" CACHE PATH "OS/2 target sysroot")
endif()

foreach(_tool CMAKE_C_COMPILER CMAKE_CXX_COMPILER CMAKE_AR)
  if(NOT EXISTS "${${_tool}}")
    message(FATAL_ERROR "Required OS/2 cross tool is missing: ${${_tool}}")
  endif()
endforeach()
if(NOT IS_DIRECTORY "${CMAKE_SYSROOT}")
  message(FATAL_ERROR "OS/2 target sysroot is missing: ${CMAKE_SYSROOT}")
endif()

# emxomfar writes OMF archives itself; GNU ranlib must never post-process them.
if(NOT DEFINED CMAKE_C_ARCHIVE_CREATE OR CMAKE_C_ARCHIVE_CREATE STREQUAL "")
  set(CMAKE_C_ARCHIVE_CREATE "<CMAKE_AR> cr <TARGET> <OBJECTS>")
endif()
if(NOT DEFINED CMAKE_C_ARCHIVE_APPEND OR CMAKE_C_ARCHIVE_APPEND STREQUAL "")
  set(CMAKE_C_ARCHIVE_APPEND "<CMAKE_AR> r <TARGET> <OBJECTS>")
endif()
if(NOT DEFINED CMAKE_C_ARCHIVE_FINISH OR CMAKE_C_ARCHIVE_FINISH STREQUAL "")
  set(CMAKE_C_ARCHIVE_FINISH "<CMAKE_COMMAND> -E true")
endif()
if(NOT DEFINED CMAKE_CXX_ARCHIVE_CREATE OR CMAKE_CXX_ARCHIVE_CREATE STREQUAL "")
  set(CMAKE_CXX_ARCHIVE_CREATE "<CMAKE_AR> cr <TARGET> <OBJECTS>")
endif()
if(NOT DEFINED CMAKE_CXX_ARCHIVE_APPEND OR CMAKE_CXX_ARCHIVE_APPEND STREQUAL "")
  set(CMAKE_CXX_ARCHIVE_APPEND "<CMAKE_AR> r <TARGET> <OBJECTS>")
endif()
if(NOT DEFINED CMAKE_CXX_ARCHIVE_FINISH OR CMAKE_CXX_ARCHIVE_FINISH STREQUAL "")
  set(CMAKE_CXX_ARCHIVE_FINISH "<CMAKE_COMMAND> -E true")
endif()

list(PREPEND CMAKE_FIND_ROOT_PATH "${CMAKE_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)

set(_os2_tk_flags "")
if(IS_DIRECTORY "${CMAKE_SYSROOT}/include/os2tk45")
  set(_os2_tk_flags " -idirafter ${CMAKE_SYSROOT}/include/os2tk45")
endif()
set(CMAKE_C_FLAGS_INIT "-Zomf -Zsym -Zmap -O2${_os2_tk_flags}")
set(CMAKE_CXX_FLAGS_INIT "-Zomf -Zsym -Zmap -O2${_os2_tk_flags}")
set(CMAKE_EXE_LINKER_FLAGS_INIT "-Zomf -Zsym -Zmap -Zcrtdll")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "-Zomf -Zsym -Zmap -Zcrtdll")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "-Zomf -Zsym -Zmap -Zcrtdll")
set(CMAKE_C_STANDARD_LIBRARIES_INIT "-lcx -Zcrtdll")
set(CMAKE_CXX_STANDARD_LIBRARIES_INIT "-lcx -Zcrtdll")
