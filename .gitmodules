[submodule "libc"]
	path = libc
	url = https://github.com/OS2DLLS/libc-os2.git
	branch = master
[submodule "cmake-os2"]
	path = cmake-os2
	url = https://github.com/OS2DLLS/cmake-os2.git
	branch = master
[submodule "binutils-os2"]
	path = binutils-os2
	url = https://github.com/OS2DLLS/binutils-os2.git
	branch = master
	shallow = true
[submodule "gcc-os2"]
	path = gcc-os2
	url = https://github.com/OS2DLLS/gcc-os2.git
	branch = master
	shallow = true
